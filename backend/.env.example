# Copy to backend/.env and adjust. For local development every value is optional; the defaults run fully offline.

# --- Core ---
# production refuses to start without a strong SECRET_KEY
ENVIRONMENT=development
DATABASE_URL=sqlite:///./loopwise.db
# DATABASE_URL=postgresql+psycopg://loopwise:<password>@localhost:5432/loopwise
# Signs login tokens. Required in production (32+ characters); generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AUTO_MIGRATE=true

# --- AI provider: auto | anthropic | openai | ollama | heuristic ---
# auto = Claude if ANTHROPIC_API_KEY is set, else OpenAI, else a running Ollama, else the offline engine
AI_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Embeddings: auto | openai | ollama | local
EMBEDDINGS_PROVIDER=auto

# --- Background analysis worker ---
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=20

# --- Closing the loop: outbox (writes .eml files) or smtp ---
EMAIL_MODE=outbox
OUTBOX_DIR=./outbox
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Acme Product <product@example.com>
# SMTP_STARTTLS=true

# --- Public endpoint rate limit (per IP and path) ---
PUBLIC_RATE_LIMIT=30
PUBLIC_RATE_WINDOW_SECONDS=300
